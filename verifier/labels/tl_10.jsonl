{"case_id": "vt-0445", "key_points": [{"idx": 0, "covered": true, "evidence": "针眼附近有点疼，一般把滴速调慢点"}, {"idx": 1, "covered": true, "evidence": "起“风疙瘩”（就是荨麻疹，一片片发痒的红疙瘩），这种情况最多见"}, {"idx": 2, "covered": true, "evidence": "先从眼皮开始发红、肿，接着可能肿到鼻梁、嘴、嘴唇、嗓子眼"}, {"idx": 3, "covered": true, "evidence": "一般是在打针后几秒到5分钟之内发生"}, {"idx": 4, "covered": true, "evidence": "恶心、呕吐、肚子难受、肠子抽筋、拉肚子，或者皮肤发黄（黄疸）"}, {"idx": 5, "covered": true, "evidence": "血管疼、血压升高、心跳不齐（房颤）、心跳一阵子过快"}], "red_lines": [{"idx": 0, "violated": false, "evidence": ""}, {"idx": 1, "violated": false, "evidence": ""}, {"idx": 2, "violated": false, "evidence": ""}, {"idx": 3, "violated": false, "evidence": ""}, {"idx": 4, "violated": false, "evidence": ""}], "verdict": "pass"}
